          "position": { "x": 0, "y": 0, "width": 6, "height": 2 }
        },
        {
          "widget": {
            "name": "map_destinations",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_destinations_map", "fields": [{ "name": "destination", "expression": "`destination`" }, { "name": "country_name", "expression": "`country_name`" }, { "name": "lat", "expression": "`lat`" }, { "name": "lon", "expression": "`lon`" }, { "name": "revenue", "expression": "`revenue`" }, { "name": "occupancy_pct", "expression": "`occupancy_pct`" }, { "name": "revpar", "expression": "`revpar`" }, { "name": "market_segment", "expression": "`market_segment`" }, { "name": "hotels_count", "expression": "`hotels_count`" }], "disaggregated": true } }],
            "spec": {
              "version": 3, "widgetType": "symbol-map",
