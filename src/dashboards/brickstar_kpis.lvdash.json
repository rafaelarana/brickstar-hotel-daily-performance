{
  "_comment": "Brickstar Hotel Daily Performance · 3-tab Lakeview dashboard styled with the Brickstar dashboard style skill. Datasets query the UC Metric View; warehouse + schema are bundle-resolved.",
  "datasets": [
    {
      "name": "ds_portfolio_kpis",
      "displayName": "Portfolio KPIs (Metric View)",
      "queryLines": [
        "SELECT\n",
        "  MEASURE(total_revenue_eur)        AS total_revenue,\n",
        "  MEASURE(portfolio_occupancy_pct)  AS occupancy_pct,\n",
        "  MEASURE(portfolio_revpar_eur)     AS revpar,\n",
        "  MEASURE(avg_adr_eur)              AS adr,\n",
        "  MEASURE(avg_nps_score)            AS nps,\n",
        "  MEASURE(total_cancellations)      AS cancellations,\n",
        "  MEASURE(total_gop_proxy_eur)      AS gop\n",
        "FROM metric_view_hotel_kpis"
      ]
    },
    {
      "name": "ds_daily_trend",
      "displayName": "Daily portfolio trend",
      "queryLines": [
        "SELECT metric_date,\n",
        "       MEASURE(total_revenue_eur)        AS total_revenue,\n",
        "       MEASURE(portfolio_occupancy_pct)  AS occupancy_pct,\n",
        "       MEASURE(portfolio_revpar_eur)     AS revpar,\n",
        "       MEASURE(avg_adr_eur)              AS adr\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY metric_date\n",
        "ORDER BY metric_date"
      ]
    },
    {
      "name": "ds_top_hotels",
      "displayName": "Top hotels by RevPAR",
      "queryLines": [
        "SELECT hotel_name, destination, market_segment,\n",
        "       MEASURE(portfolio_revpar_eur)    AS revpar,\n",
        "       MEASURE(avg_occupancy_pct)       AS occupancy_pct,\n",
        "       MEASURE(total_revenue_eur)       AS total_revenue\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY hotel_name, destination, market_segment\n",
        "ORDER BY revpar DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_by_market",
      "displayName": "By market segment",
      "queryLines": [
        "SELECT market_segment,\n",
        "       MEASURE(portfolio_revpar_eur)    AS revpar,\n",
        "       MEASURE(portfolio_occupancy_pct) AS occupancy_pct,\n",
        "       MEASURE(avg_adr_eur)             AS adr,\n",
        "       MEASURE(total_revenue_eur)       AS revenue,\n",
        "       MEASURE(avg_nps_score)           AS nps\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY market_segment\n",
        "ORDER BY revpar DESC"
      ]
    },
    {
      "name": "ds_segment_revenue_share",
      "displayName": "Revenue share by segment",
      "queryLines": [
        "SELECT market_segment,\n",
        "       MEASURE(total_revenue_eur) AS revenue\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY market_segment\n",
        "ORDER BY revenue DESC"
      ]
    },
    {
      "name": "ds_hotel_scatter",
      "displayName": "ADR vs Occupancy per hotel",
      "queryLines": [
        "SELECT hotel_name, market_segment, destination,\n",
        "       MEASURE(avg_adr_eur)             AS adr,\n",
        "       MEASURE(avg_occupancy_pct)       AS occupancy_pct,\n",
        "       MEASURE(total_revenue_eur)       AS revenue\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY hotel_name, market_segment, destination"
      ]
    },
    {
      "name": "ds_nps_distribution",
      "displayName": "NPS distribution by hotel",
      "queryLines": [
        "SELECT hotel_name, market_segment,\n",
        "       MEASURE(avg_nps_score) AS nps\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY hotel_name, market_segment\n",
        "ORDER BY nps ASC"
      ]
    },
    {
      "name": "ds_cancellations_trend",
      "displayName": "Cancellations trend",
      "queryLines": [
        "SELECT metric_date,\n",
        "       MEASURE(total_cancellations) AS cancellations,\n",
        "       MEASURE(total_reservations)  AS reservations\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY metric_date\n",
        "ORDER BY metric_date"
      ]
    },
    {
      "name": "ds_segment_trend",
      "displayName": "Daily RevPAR by segment",
      "queryLines": [
        "SELECT metric_date, market_segment,\n",
        "       MEASURE(portfolio_revpar_eur) AS revpar\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY metric_date, market_segment\n",
        "ORDER BY metric_date"
      ]
    },
    {
      "name": "ds_at_risk_hotels",
      "displayName": "Hotels needing attention",
      "queryLines": [
        "SELECT hotel_name, destination, market_segment,\n",
        "       MEASURE(avg_nps_score)           AS nps,\n",
        "       MEASURE(portfolio_occupancy_pct) AS occupancy_pct,\n",
        "       MEASURE(portfolio_revpar_eur)    AS revpar,\n",
        "       MEASURE(total_cancellations)     AS cancellations\n",
        "FROM metric_view_hotel_kpis\n",
        "GROUP BY hotel_name, destination, market_segment\n",
        "HAVING MEASURE(avg_nps_score) < 55 OR MEASURE(portfolio_occupancy_pct) < 50\n",
        "ORDER BY nps ASC, occupancy_pct ASC LIMIT 20"
      ]
    },
    {
      "name": "ds_destinations_map",
      "displayName": "Destinations geo (lat/lon + revenue)",
      "queryLines": [
        "SELECT g.destination, g.country_name, g.country_iso3, g.lat, g.lon, g.market_segment,\n",
        "       g.revenue,\n",
        "       g.occupancy_pct,\n",
        "       g.revpar,\n",
        "       g.hotels_count\n",
        "FROM (\n",
        "  SELECT geo.destination, geo.country_name, geo.country_iso3, geo.lat, geo.lon,\n",
        "         k.market_segment,\n",
        "         SUM(k.daily_revenue_eur)               AS revenue,\n",
        "         AVG(k.occupancy_pct)                   AS occupancy_pct,\n",
        "         SUM(k.daily_revenue_eur) / NULLIF(SUM(k.rooms_total), 0) AS revpar,\n",
        "         COUNT(DISTINCT k.hotel_id)             AS hotels_count\n",
        "  FROM gold_hotel_daily_kpis k\n",
        "  JOIN destinations_geo geo USING (destination)\n",
        "  GROUP BY geo.destination, geo.country_name, geo.country_iso3, geo.lat, geo.lon, k.market_segment\n",
        ") g\n",
        "ORDER BY g.revenue DESC"
      ]
    },
    {
      "name": "ds_country_choropleth",
      "displayName": "Country revenue (choropleth)",
      "queryLines": [
        "SELECT geo.country_iso3, geo.country_name,\n",
        "       SUM(k.daily_revenue_eur)                                 AS revenue,\n",
        "       AVG(k.occupancy_pct)                                     AS occupancy_pct,\n",
        "       SUM(k.daily_revenue_eur) / NULLIF(SUM(k.rooms_total), 0) AS revpar\n",
        "FROM gold_hotel_daily_kpis k\n",
        "JOIN destinations_geo geo USING (destination)\n",
        "GROUP BY geo.country_iso3, geo.country_name\n",
        "ORDER BY revenue DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_overview",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "title_overview",
            "textbox_spec": "# Portfolio performance today\n\n_Governed KPIs from the metric view · Refreshed by the medallion pipeline_"
          },
          "position": { "x": 0, "y": 0, "width": 6, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_revenue",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_portfolio_kpis", "fields": [{ "name": "total_revenue", "expression": "`total_revenue`" }], "disaggregated": true } }],
            "spec": {
              "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "total_revenue", "displayName": "Revenue total", "format": { "type": "number-currency", "currencyCode": "EUR", "abbreviation": "compact" }, "style": { "color": "#002855" } } },
              "frame": { "showTitle": true, "title": "REVENUE TOTAL" }
            }
          },
          "position": { "x": 0, "y": 2, "width": 1, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_occupancy",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_portfolio_kpis", "fields": [{ "name": "occupancy_pct", "expression": "`occupancy_pct`" }], "disaggregated": true } }],
            "spec": {
              "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "occupancy_pct", "displayName": "Ocupación", "format": { "type": "number-plain", "decimalPlaces": { "type": "exact", "places": 1 } }, "style": { "color": "#3AA597" } } },
              "frame": { "showTitle": true, "title": "OCUPACIÓN (%)" }
            }
          },
          "position": { "x": 1, "y": 2, "width": 1, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_revpar",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_portfolio_kpis", "fields": [{ "name": "revpar", "expression": "`revpar`" }], "disaggregated": true } }],
            "spec": {
              "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "revpar", "displayName": "RevPAR", "format": { "type": "number-currency", "currencyCode": "EUR" }, "style": { "color": "#3AA597" } } },
              "frame": { "showTitle": true, "title": "REVPAR (€)" }
            }
          },
          "position": { "x": 2, "y": 2, "width": 1, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_adr",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_portfolio_kpis", "fields": [{ "name": "adr", "expression": "`adr`" }], "disaggregated": true } }],
            "spec": {
              "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "adr", "displayName": "ADR", "format": { "type": "number-currency", "currencyCode": "EUR" }, "style": { "color": "#A6C26E" } } },
              "frame": { "showTitle": true, "title": "ADR MEDIO" }
            }
          },
          "position": { "x": 3, "y": 2, "width": 1, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_nps",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_portfolio_kpis", "fields": [{ "name": "nps", "expression": "`nps`" }], "disaggregated": true } }],
            "spec": {
              "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "nps", "displayName": "NPS", "format": { "type": "number-plain", "decimalPlaces": { "type": "exact", "places": 1 } }, "style": { "color": "#FFD54F" } } },
              "frame": { "showTitle": true, "title": "NPS MEDIO" }
            }
          },
          "position": { "x": 4, "y": 2, "width": 1, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_gop",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_portfolio_kpis", "fields": [{ "name": "gop", "expression": "`gop`" }], "disaggregated": true } }],
            "spec": {
              "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "gop", "displayName": "GOP proxy", "format": { "type": "number-currency", "currencyCode": "EUR", "abbreviation": "compact" }, "style": { "color": "#524BB9" } } },
              "frame": { "showTitle": true, "title": "GOP PROXY" }
            }
          },
          "position": { "x": 5, "y": 2, "width": 1, "height": 3 }
        },
        {
          "widget": {
            "name": "trend_revenue",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_daily_trend", "fields": [{ "name": "metric_date", "expression": "`metric_date`" }, { "name": "total_revenue", "expression": "`total_revenue`" }], "disaggregated": false } }],
            "spec": {
