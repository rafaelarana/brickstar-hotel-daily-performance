                  { "fieldName": "occupancy_pct", "displayName": "Ocupación (%)", "type": "float", "format": { "type": "number-plain", "decimalPlaces": { "type": "exact", "places": 1 } } },
                  { "fieldName": "revpar",        "displayName": "RevPAR (€)",    "type": "float", "format": { "type": "number-currency", "currencyCode": "EUR" } }
                ]
              },
              "frame": { "showTitle": true, "title": "Destinations · ranked by revenue" }
            }
          },
          "position": { "x": 0, "y": 17, "width": 6, "height": 5 }
        }
      ]
    },
    {
      "name": "page_segments",
      "displayName": "Segments",
      "layout": [
        {
          "widget": {
            "name": "title_segments",
            "textbox_spec": "# Segments\n\n_Revenue share, RevPAR vs ADR, ADR/occupancy scatter, daily RevPAR trend per market segment_"
          },
          "position": { "x": 0, "y": 0, "width": 6, "height": 2 }
        },
        {
          "widget": {
