              "frame": { "showTitle": true, "title": "Top 15 hoteles · RevPAR" }
            }
          },
          "position": { "x": 0, "y": 13, "width": 3, "height": 5 }
        },
        {
          "widget": {
            "name": "by_market_table",
            "queries": [{ "name": "main_query", "query": { "datasetName": "ds_by_market", "fields": [{ "name": "market_segment", "expression": "`market_segment`" }, { "name": "revpar", "expression": "`revpar`" }, { "name": "occupancy_pct", "expression": "`occupancy_pct`" }, { "name": "adr", "expression": "`adr`" }, { "name": "revenue", "expression": "`revenue`" }, { "name": "nps", "expression": "`nps`" }], "disaggregated": false } }],
            "spec": {
              "version": 1, "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "market_segment", "displayName": "Segmento", "type": "string" },
                  { "fieldName": "revpar",         "displayName": "RevPAR (€)",     "type": "float", "format": { "type": "number-currency", "currencyCode": "EUR" } },
                  { "fieldName": "occupancy_pct",  "displayName": "Ocupación (%)",  "type": "float", "format": { "type": "number-plain", "decimalPlaces": { "type": "exact", "places": 1 } } },
                  { "fieldName": "adr",            "displayName": "ADR (€)",        "type": "float", "format": { "type": "number-currency", "currencyCode": "EUR" } },
                  { "fieldName": "revenue",        "displayName": "Revenue (€)",    "type": "float", "format": { "type": "number-currency", "currencyCode": "EUR", "abbreviation": "compact" } },
                  { "fieldName": "nps",            "displayName": "NPS",            "type": "float", "format": { "type": "number-plain", "decimalPlaces": { "type": "exact", "places": 1 } } }
                ]
              },
              "frame": { "showTitle": true, "title": "Performance por segmento de mercado" }
            }
          },
          "position": { "x": 3, "y": 13, "width": 3, "height": 5 }
        }
      ]
    },
    {
      "name": "page_geo",
      "displayName": "Geo · Map",
      "layout": [
        {
          "widget": {
            "name": "title_geo",
            "textbox_spec": "# Geographic footprint\n\n_Each circle = a destination · size = revenue · color = market segment. Countries colored by total revenue (choropleth)._"
